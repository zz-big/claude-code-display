// ----------------------------------------------------------------------------
// Local configuration. Copy this file to `config.h` and fill in your values.
// `config.h` is gitignored — it stays on your machine only.
// ----------------------------------------------------------------------------
#pragma once

// ----- WiFi -----------------------------------------------------------------
// ESP32-C3 only supports 2.4 GHz networks (no 5 GHz).
#define WIFI_SSID      "YOUR_WIFI_SSID"
#define WIFI_PASSWORD  "YOUR_WIFI_PASSWORD"

// ----- mDNS hostname --------------------------------------------------------
// The device will be reachable at http://<MDNS_NAME>.local on your LAN.
#define MDNS_NAME      "claude-display"

// ----- Timezone -------------------------------------------------------------
// Offset from UTC in seconds. Examples:
//   China  (UTC+8): 8 * 3600
//   UTC          :  0
//   US East (UTC-5):-5 * 3600
//   Europe  (UTC+1): 1 * 3600
#define TZ_OFFSET_SEC  (8 * 3600)
